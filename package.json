{
  "name": "@scriptivox/mcp-server",
  "version": "1.1.3",
  "mcpName": "com.scriptivox.www/transcription",
  "description": "MCP server for Scriptivox AI transcription — transcribe audio/video from any AI assistant. 119 languages, speaker diarization, word-level timestamps, full CRUD on transcriptions (submit, cancel, delete, list), and SRT/VTT/text export.",
  "keywords": [
    "mcp",
    "transcription",
    "ai",
    "audio",
    "video",
    "scriptivox",
    "speech-to-text",
    "model-context-protocol"
  ],
  "license": "MIT",
  "author": "Scriptivox",
  "homepage": "https://scriptivox.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/SparkleOfficial/scriptivox-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/SparkleOfficial/scriptivox-mcp-server/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "scriptivox-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "smithery.yaml"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "smoke": "tsx scripts/smoke.ts",
    "integration": "npm run build && tsx scripts/integration.ts",
    "test": "npm run smoke && npm run integration",
    "release": "node scripts/release.mjs",
    "prepublishOnly": "npm run build && npm run test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.22.3",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
